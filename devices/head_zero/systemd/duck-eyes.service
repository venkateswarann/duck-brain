[Unit]
Description=Duck eyes (GC9A01 x2) HTTP API on :8100
Conflicts=duck-boot-status.service
After=duck-boot-status.service
Wants=duck-headcam.service
# Crashing for good brings the status screen back with the error on it.
OnFailure=duck-boot-status.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
SupplementaryGroups=spi gpio
WorkingDirectory=@DIR@
# As root ("+"): let udev finish (PWM permissions), and put the ear pins back on
# hardware PWM in case a software-PWM fallback left them as plain outputs.
ExecStartPre=+-/usr/bin/udevadm settle --timeout=5
ExecStartPre=+-/usr/bin/pinctrl set 12 a0
ExecStartPre=+-/usr/bin/pinctrl set 13 a0
ExecStart=@DIR@/.venv/bin/python eyes_server.py --port 8100
Restart=on-failure
RestartSec=2

# Not enabled on its own: duck-boot-status starts it once the robot is ready.
